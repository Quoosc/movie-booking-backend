APP_NAME=Cineon
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://api.example.com
API_HOST=api.example.com
ACME_EMAIL=you@example.com
CINEMA_TIMEZONE=Asia/Ho_Chi_Minh
FRONTEND_REDIRECT_URL=https://cineon-cinema.vercel.app/oauth2/success
CORS_ALLOWED_ORIGINS=https://cineon-cinema.vercel.app
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=cineon
DB_USERNAME=cineon
DB_PASSWORD=
DB_ROOT_PASSWORD=

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=cineon-demo-
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none
SESSION_DOMAIN=null
SESSION_LIFETIME=120
JWT_SECRET=
JWT_TTL=500
JWT_REFRESH_TTL=43200

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYMENT_PAYPAL_CURRENCY=USD
PAYPAL_RETURN_URL=https://cineon-cinema.vercel.app/payment-callback?method=PAYPAL
PAYPAL_CANCEL_URL=https://cineon-cinema.vercel.app/checkout?paymentCancelled=1
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_API_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api
MOMO_RETURN_URL=https://cineon-cinema.vercel.app/payment-callback?method=MOMO
MOMO_IPN_URL=https://api.example.com/api/payments/momo/ipn
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.com/login/oauth2/code/google

MAIL_MAILER=log
CONTACT_NOTIFY_ENABLED=false
